{
  "manifest_version": 3,
  "name": "Swinline для SLAY",
  "version": "0.2.9",
  "description": "Перекрашивает оранжевые акценты SLAY Award в розовый и заменяет Winline на Swinline.",
  "icons": {
    "16": "assets/icons/swin-16.png",
    "32": "assets/icons/swin-32.png",
    "48": "assets/icons/swin-48.png",
    "128": "assets/icons/swin-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/swin-16.png",
      "24": "assets/icons/swin-24.png",
      "32": "assets/icons/swin-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://slay-award.ru/*"],
      "js": ["palette.js", "theme.js"],
      "css": ["theme.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://slay-award.ru/", "https://slay-award.ru/?*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/replacements/*.png",
        "assets/replacements/swinline-logo.svg",
        "assets/replacements/swinline-hero.mp4",
        "assets/replacements/swinline-hero-mobile.mp4"
      ],
      "matches": ["https://slay-award.ru/*"]
    }
  ]
}
